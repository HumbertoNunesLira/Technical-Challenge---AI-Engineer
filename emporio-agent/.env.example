# Copy this file to .env and fill in the key for the provider you use.

# LLM provider: "anthropic" (default) or "openai" (OpenAI-compatible: OpenAI, Gemini, Ollama)
LLM_PROVIDER=anthropic
# Leave empty to use the provider default
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Agent clock as an ISO datetime, e.g. 2026-03-23T10:00:00-04:00. Empty means real time.
AGENT_NOW=
# Set to 1 to print tool calls in the CLI
SHOW_TOOLS=0
